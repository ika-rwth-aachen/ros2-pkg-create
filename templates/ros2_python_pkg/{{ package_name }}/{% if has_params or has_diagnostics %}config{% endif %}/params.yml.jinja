/**/*:
  ros__parameters:
{% if has_params %}
    param: 1.0
{% endif %}
{% if has_diagnostics %}
    diagnostic_updater:
      period: 1.0
      # Prefix statuses with the fully qualified node name, including its namespace.
      # Example: /perception/processor: health. This does not rename topics.
      use_fqn: true
{% if has_subscriber %}
      topic_diagnostic:
        enabled: true
        # Example periodic input bounds; adapt these to the application's contract.
        min_frequency: 0.5
        max_frequency: 1.0
        min_acceptable_timestamp_delta: -0.1
        max_acceptable_timestamp_delta: 0.1
        # timeout: 6.0  # Derived: max(3 / min_frequency, 0.5) seconds.
{% endif %}
{% if has_publisher %}
      diagnosed_publisher:
        enabled: true
        # Example periodic output bounds; disable monitoring for event-driven output.
        min_frequency: 0.5
        max_frequency: 1.0
        min_acceptable_timestamp_delta: -0.1
        max_acceptable_timestamp_delta: 0.1
        # timeout: 6.0  # Derived: max(3 / min_frequency, 0.5) seconds.
{% endif %}
{% endif %}
